import React from "react";
import { Text, ImageBackground, ScrollView, StyleSheet, View } from "react-native";

export default function Sentimentos() {
  return (
    <ImageBackground source={require("../Imagens/sentimentos.png")} style={styles.fundo} resizeMode="cover" >
      <ScrollView contentContainerStyle={styles.conteudo}>
        <View style={styles.caixa}>
          <Text style={styles.titulo}>Os sentimentos e a saúde mental</Text>
          <Text style={styles.subtitulo}>
            O que podemos aprender com OMORI?
          </Text>
          <Text style={styles.paragrafo}>
            Os personagens de OMORI enfrentam conflitos emocionais, culpa,
            sofrimento e isolamento. A história mostra como sentimentos difíceis
            podem afetar a forma como uma pessoa se relaciona consigo mesma e
            com os outros.
          </Text>
          <Text style={styles.paragrafo}>
            Não devemos julgar alguém apenas pela aparência ou por parecer estar
            bem. Uma pessoa pode sorrir e continuar realizando suas atividades,
            mesmo quando está passando por um momento complicado.
          </Text>
          <Text style={styles.paragrafo}>
            Tristeza persistente, desesperança ou isolamento podem ser sinais de
            que alguém precisa de apoio. Conversar com uma pessoa de confiança e
            procurar um profissional de saúde mental pode ajudar.
          </Text>
          <Text style={styles.destaque}>
            Sentir dificuldades emocionais não torna ninguém fraco. Toda pessoa
            merece ser ouvida e tratada com respeito.
          </Text>
        </View>
      </ScrollView>
    </ImageBackground>
  );
}

