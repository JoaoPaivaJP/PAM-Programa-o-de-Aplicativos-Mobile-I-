import React from "react";
import { Text, ImageBackground, ScrollView, StyleSheet, View } from "react-native";

export default function Inicio() {
  return (
    <ImageBackground source={require("../Imagens/inicio.png")} style={styles.fundo} resizeMode="cover" >
      <ScrollView contentContainerStyle={styles.conteudo}>
        <View style={styles.caixa}>
          <Text style={styles.aluno}>João Pedro Souza Paiva</Text>
          <Text style={styles.titulo}>A prevenção ao suicídio</Text>
          <Text style={styles.subtitulo}>
            Entendendo o tema por meio do jogo OMORI
          </Text>
          <Text style={styles.paragrafo}>
            A prevenção ao suicídio está relacionada à saúde mental, ao apoio e
            à compreensão dos sentimentos. Muitas pessoas passam por
            dificuldades emocionais sem conseguir falar sobre o que estão
            vivendo.
          </Text>
          <Text style={styles.paragrafo}>
            OMORI é um jogo que apresenta temas como tristeza, isolamento, culpa
            e medo. Mesmo sendo uma obra de ficção, sua história pode servir
            como ponto de partida para refletir sobre sentimentos e sobre a
            importância de tratar as pessoas com empatia.
          </Text>
          <Text style={styles.paragrafo}>
            Este aplicativo busca incentivar conversas sobre saúde mental,
            diminuir o preconceito e lembrar que pedir ajuda é importante. O
            conteúdo é informativo e não substitui o acompanhamento de
            profissionais.
          </Text>
        </View>
      </ScrollView>
    </ImageBackground>
  );
}

