Home.js:
import { View, Text, Button, StyleSheet } from 'react-native';
import { useNavigation } from '@react-navigation/native';

export default function Home() {
    const nav = useNavigation();
    return (
        <View style={estilos.contenedor}>
            <Text style={estilos.txt}>Bem-vindo!</Text>
            <Button title="Sobre Nos" onPress={() => nav.navigate('Sobre')} />
            <Button title='Entrar' onPress={() => nav.navigate('Login')} />
            <Button title="Estudo de Flex" onPress={() => nav.navigate('Flex')} />
        </View>
    )
}
const estilos = StyleSheet.create({
    contenedor: {
        flex: 1, gap: 15, justifyContent: 'center', alignItems: 'center'
    },
    txt: {
        fontSize: 30
    }
})

