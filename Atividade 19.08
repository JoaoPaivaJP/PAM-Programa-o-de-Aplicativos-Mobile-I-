Flex.js:
// Importa os componentes View e Text e as funções de estilo StyleSheet do React Native
import { View, Text, StyleSheet } from 'react-native';

// Cria e exporta o componente chamado Flex
export default function Flex() {
  // Retorna a estrutura visual que será exibida na tela
  return (
    // View principal que utiliza o estilo "contenedor"
    <View style={estilos.contenedor} >
      <View style={estilos.esq}> {/* View da esquerda, utilizando o estilo "esq" */}
        <Text style={estilos.txt}>Esquerda</Text> {/* Texto "Esquerda" utilizando o estilo "txt" */}
      </View >
      <View style={estilos.centro}> {/* View central, utilizando o estilo "centro" */}
        <Text style={estilos.txt} >Centro</Text> {/* Texto "Centro" utilizando o estilo "txt" */}
      </View >
      <View style={estilos.dir}> {/* View da direita, utilizando o estilo "dir" */}
        <Text style={estilos.txt}>Direita</Text> {/* Texto "Direita" utilizando o estilo "txt" */}
      </View>
      {/* Fecha a View principal */}
    </View >
  );
}

// Cria uma folha de estilos chamada "estilos"
const estilos = StyleSheet.create({

  // Estilo aplicado ao container principal
  contenedor: {
    flex: 1, // Faz o container ocupar todo o espaço disponível
    backgroundColor: '#f5f5f5', // Define a cor de fundo do container
    flexDirection: 'row' // Coloca os elementos filhos lado a lado, na horizontal
  },

  // Estilo da coluna da esquerda
  esq: {
    flex: 1, // Define a proporção de espaço que essa View ocupa
    backgroundColor: '#6200ee', // Define a cor de fundo roxa
    justifyContent: 'flex-start', //Eixo vertical: Topo // Alinha o conteúdo no início do eixo principal (topo)
    alignItems: 'center' //eixo horizontal: Centro // Alinha o conteúdo no centro do eixo transversal (horizontal)
  },

  // Estilo da coluna central
  centro: {
    flex: 6, // Define a proporção de espaço que essa View ocupa
    backgroundColor: '#666', // Define a cor de fundo cinza
    alignContent: "space-between", //Eixo vertical: Separa o topo e base (caso haja mais de um elemento) ou empurra para as pontas
    alignItems: 'flex-end' //Eixo horizontal: Direita // Alinha os elementos filhos à direita
  },

  // Estilo da coluna da direita
  dir: {
    flex: 1, // Define a proporção de espaço que essa View ocupa 
    backgroundColor: '#03dac6', // Define a cor de fundo verde/azulada  
    justifyContent: 'flex-end', //Eixo vertical: Base // Alinha o conteúdo no final do eixo principal (base)
    alignItems: 'flex-start'    //Eixo horizontal: Esquerda // Alinha o conteúdo no início do eixo transversal (esquerda)
  },

  // Estilo utilizado pelos três textos
  txt: {
    color: 'white', // Define a cor do texto como branca
    fontWeight: 'bold', // Deixa o texto em negrito   
    textAlign: 'center', // Centraliza o texto
    fontSize: 14 // Define o tamanho da fonte como 14
  }

  // Fecha a criação dos estilos
});
