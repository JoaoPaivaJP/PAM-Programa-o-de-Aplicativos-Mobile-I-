            </ScrollView></View>
    )
}

const estilos = {
    contenedor: {
        flex: 1, backgroundColor: '#F5F5F5', // Um cinza bem claro para fundo
    },
    txt: {
        fontSize: 16,
        lineHeight: 26, // Espaçamento entre linhas (importante para textos longos)
        color: '#444',
        marginBottom: 20, // Distância entre os parágrafos
        textAlign: 'justify', // Alinhamento justificado para um visual limpo
    },
    rolagem: {
        paddingHorizontal: 20,
        paddingVertical: 20,
    }
}

Home.js: 
import { View, Text, Button, StyleSheet } from 'react-native';
import { useNavigation } from '@react-navigation/native';
export default function Home() {
    const nav = useNavigation();
    return (
        <View style={estilos.contenedor}>
            <Text style={estilos.txt}>Bem-vindo!</Text>
            <Button title="Sobre Nós" onPress={() => nav.navigate('Sobre')} />{/* Em funções que tem apenas uma linha de código, a arrow function não precisa de chaves */}
            <Button title="Entrar" onPress={() => nav.navigate('Login')} />
            <Button title="Estudo de Flex" onPress={() => nav.navigate('Flex')} />
        </View>)
}
const estilos = StyleSheet.create({
    contenedor: {
        flex: 1, gap: 15, justifyContent: 'center',
        alignItems: 'center'
    },
    txt: { fontSize: 30 }
})

Login.js:
import { View, Text } from 'react-native';

export default function Login() {
    return (
        <View>
            <Text>Logado</Text>
        </View>
    )
}

App.js:
import { NavigationContainer } from "@react-navigation/native";

import Home from "./fonte/telas/Home";
import Flex from "./fonte/telas/Flex";
import Login from "./fonte/telas/Login";
import Sobre from "./fonte/telas/Sobre";

import { createNativeStackNavigator } from "@react-navigation/native-stack";

const Stack = createNativeStackNavigator();
export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator>
        <Stack.Screen name="Home" component={Home} options={{ headerShown: false }} />
        <Stack.Screen name="Flex" component={Flex} />
        <Stack.Screen name="Login" component={Login} />
        <Stack.Screen name="Sobre" component={Sobre} options={{ title: 'Sobre nós', headerStyle: { backgroundColor: '#cc0000' }, headerTintColor: '#fff' }} />
      </Stack.Navigator>
    </NavigationContainer>
  )
}
